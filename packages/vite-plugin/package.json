{
  "name": "@luxojs/vite-plugin",
  "version": "1.0.0-beta.1",
  "description": "Luxo Vite plugin — compile-time field tracking, auto $select injection, and typed client generation",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "keywords": ["luxo", "vite", "plugin", "codegen", "field-tracking", "select", "babel", "ast"],
  "repository": {
    "type": "git",
    "url": "https://github.com/light-speak/luxo.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/light-speak/luxo",
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@luxojs/client": "1.0.0-beta.1",
    "typescript": ">=7.0 <8",
    "vite": ">=5.0"
  },
  "dependencies": {
    "@babel/parser": "^8.0.5",
    "@babel/traverse": "^8.0.5",
    "@babel/types": "^8.0.5"
  },
  "devDependencies": {
    "@luxojs/client": "link:../client",
    "@types/node": "^26.5.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
