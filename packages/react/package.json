{
  "name": "@luxojs/react",
  "version": "1.0.0-beta.1",
  "description": "Luxo React hooks — useLuxoQuery / useLuxoMutation with compile-time field tracking",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "luxo",
    "react",
    "hooks",
    "query",
    "mutation",
    "field-selection",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/light-speak/luxo.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/light-speak/luxo",
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@luxojs/client": "1.0.0-beta.1",
    "react": ">=18.0"
  },
  "devDependencies": {
    "@luxojs/client": "link:../client",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
