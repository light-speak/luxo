{
  "name": "@luxojs/client",
  "version": "0.1.0-dev.3",
  "description": "Luxo client SDK — HTTP/2 + WebSocket transport with binary codec, type-safe API calls, and automatic field selection",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "Apache-2.0",
  "keywords": ["luxo", "api", "rpc", "sdk", "binary", "codec", "http2", "websocket", "field-selection"],
  "repository": {
    "type": "git",
    "url": "https://github.com/light-speak/luxo.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/light-speak/luxo",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "typescript": ">=5.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
