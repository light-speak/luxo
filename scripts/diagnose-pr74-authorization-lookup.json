    "+func TestExtractBearerTokenHeaderValues(t *testing.T) {",
    "+\tfor _, sample := range []struct {",
    "+\t\tname   string",
    "+\t\theader http.Header",
    "+\t\twant   string",
    "+\t}{",
    "+\t\t{name: \"nil map\"},",
    "+\t\t{name: \"absent key\", header: http.Header{}},",
    "+\t\t{name: \"nil slice\", header: http.Header{\"Authorization\": nil}},",
    "+\t\t{name: \"empty slice\", header: http.Header{\"Authorization\": {}}},",
    "+\t\t{name: \"direct noncanonical key\", header: http.Header{\"authorization\": {\"Bearer ignored\"}}},",
    "+\t\t{name: \"empty first value\", header: http.Header{\"Authorization\": {\"\", \"Bearer ignored\"}}},",
    "+\t\t{name: \"other scheme first\", header: http.Header{\"Authorization\": {\"Basic example\", \"Bearer ignored\"}}},",
    "+\t\t{name: \"empty bearer first\", header: http.Header{\"Authorization\": {\"Bearer \", \"Bearer ignored\"}}},",
    "+\t\t{name: \"first bearer wins\", header: http.Header{\"Authorization\": {\"bEaReR original\", \"Bearer ignored\"}}, want: \"original\"},",
    "+\t\t{name: \"canonical key wins\", header: http.Header{\"authorization\": {\"Bearer ignored\"}, \"Authorization\": {\"Bearer original\"}}, want: \"original\"},",
    "+\t\t{name: \"suffix is unchanged\", header: http.Header{\"Authorization\": {\"Bearer  original \"}}, want: \" original \"},",
    "+\t} {",
    "+\t\tt.Run(sample.name, func(t *testing.T) {",
    "+\t\t\tif got := extractBearerToken(&http.Request{Header: sample.header}); got != sample.want {",
    "+\t\t\t\tt.Errorf(\"extractBearerToken = %q, want %q\", got, sample.want)",
    "+\t\t\t}",
    "+\t\t})",
    "+\t}",
