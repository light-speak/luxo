// Luxo Example Schema — demonstrates core language features.

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id:        UUID      @auto
  name:      String
  email:     String    @unique
  password:  String    @hidden
  role:      Role
  bio:       String?
  tags:      [String]
  avatar:    Bytes?
  createdAt: DateTime
  updatedAt: DateTime
}

model Post {
  id:        Int       @serial
  title:     String
  content:   String
  published: Boolean
  authorId:  Int       @immutable
  createdAt: DateTime
  updatedAt: DateTime
}

model Order {
  id:        Int          @serial
  userId:    Int          @immutable
  status:    OrderStatus
  total:     Decimal
  note:      String?
  createdAt: DateTime
}
