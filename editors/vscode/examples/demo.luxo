// ============================================
// Luxo 语法完整演示 / Luxo Complete Syntax Demo
// 覆盖所有语法特性，自包含无外部依赖
// ============================================

// ============================================
// enum — 枚举类型 / Enumeration types
// ============================================

enum Role {
  USER
  ADMIN
  MODERATOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ============================================
// model — 数据模型 / Data models
// 支持继承(:)、注解(@)、默认值(=)、可空(?)
// ============================================

/// 用户模型 / User model
model User {
  id:        Int
  name:      String
  email:     String    @unique
  password:  String    @hidden @hash
  role:      Role      = Role.USER
  avatar:    String?
  phone:     String    @immutable
  status:    String    @internal
  createdAt: DateTime
}

/// 文章模型 / Post model
model Post {
  id:        Int
  title:     String    @filterable
  content:   String
  status:    PostStatus = PostStatus.DRAFT
  userId:    Int        @index
  likes:     Int        = 0
  createdAt: DateTime   @sortable
}

/// 评论模型 / Comment model
model Comment {
  id:        Int
  content:   String
  postId:    Int
  userId:    Int
  createdAt: DateTime
}

// ============================================
// sealed — 密封类型 / Sealed types
// when 必须穷举所有分支
// ============================================

sealed PayResult {
  Success(transactionId: String)
  Failed(reason: String, code: Int)
  Pending(retryAfter: Duration)
}

// ============================================
// type — 自定义类型 / Custom types
// 支持泛型 / Supports generics
// ============================================

type AuthResult {
  token: String
  user:  User
}

type RegisterInput {
  name:     String
  email:    String
  password: String
}

type Page<T> {
  items:    [T]
  total:    Int
  page:     Int
  pageSize: Int
}

// ============================================
// interface — 接口 / Interfaces
// 可以带默认实现 / Can have default implementations
// ============================================

interface Auditable {
  createdBy: String
  updatedBy: String

  fn beforeCreate() {
    val x = 1
  }
}

// ============================================
// api — 接口定义 / API definitions
// 三种写法 / Three styles
// ============================================

// 写法 1: 纯声明 — 框架自动实现
// Style 1: Pure declaration — auto-generated
api getUser(id: Int): User @cache(ttl: 60)
api listUsers(limit: Int = 20): [User]
api deleteUser(id: Int): Boolean @auth(role: "admin")

// 写法 2: 带逻辑 — luxo 代码
// Style 2: With logic — luxo code

/// 注册新用户 / Register new user
/// 密码通过 `@hash` 自动加密 / Password auto-hashed via `@hash`
api register(input: RegisterInput): AuthResult {
  // ?: 条件断言 / Conditional assertion
  input.password.length >= 8 ?: throw error.password_too_short

  // find 查询 / find query
  val exists = find(User, where: email == input.email)
  exists == null ?: throw error.email_exists

  // create 创建 / create record
  val user = create(User,
    name: input.name,
    email: input.email,
    password: input.password
  )

  // Duration 字面量 / Duration literal
  val token = generateToken(user, expires: 7d)

  // 最后一行表达式 = 返回值 / Last expression = return value
  AuthResult { token: token, user: user }
}

/// 创建文章 / Create post
api createPost(title: String, content: String): Post @auth {
  val post = create(Post,
    title: title,
    content: content,
    userId: currentUser.id,
    status: PostStatus.DRAFT
  )
  // emit 异步事件 / Async event
  emit("post.created", post, userId: currentUser.id)
  post
}

/// 发布文章 — 展示 ?. 和 ?: / Publish post — shows ?. and ?:
api publishPost(id: Int): Post @auth {
  val post = find(Post, id: id)
    ?: throw error.not_found

  val updated = update(post, status: PostStatus.PUBLISHED)
  emit("post.published", updated)
  updated
}

/// when + sealed — 模式匹配 / Pattern matching
api handlePayResult(result: PayResult): String {
  val message = when(result) {
    is Success -> "支付成功"
    is Failed  -> "支付失败"
    is Pending -> "等待中"
  }
  message
}

/// for 循环 + 集合操作 / For loop + collection operations
api batchProcess(ids: [Int]): Int {
  val items = find(Post, where: id in ids)

  // for 循环 / for loop
  for item in items {
    update(item, status: PostStatus.ARCHIVED)
  }

  // 集合方法 / Collection methods
  val titles = items.map { it.title }
  val active = items.filter { it.status == PostStatus.PUBLISHED }
  val hasLiked = items.any { it.likes > 0 }
  val totalLikes = items.sumOf { it.likes }

  items.size
}

/// when 表达式 — 无 subject / when expression — no subject
api getDiscount(total: Float, role: Role): Float {
  when {
    role == Role.ADMIN     -> total * 0.5
    role == Role.MODERATOR -> total * 0.8
    total > 1000           -> total * 0.9
    else                   -> total
  }
}

/// when 表达式 — 有 subject + 范围 / when with subject + range
api getLevel(score: Int): String {
  when(score) {
    in 90..100 -> "A"
    in 80..89  -> "B"
    in 60..79  -> "C"
    else       -> "D"
  }
}

/// if/else 语句 / if/else statement
api checkAge(age: Int): String {
  if age >= 18 {
    "adult"
  } else {
    "minor"
  }
}

/// transaction 事务 / Database transaction
api transferLikes(fromId: Int, toId: Int, amount: Int): Boolean {
  val fromPost = find(Post, id: fromId) ?: throw error.not_found
  val toPost = find(Post, id: toId) ?: throw error.not_found

  transaction {
    update(fromPost, likes: fromPost.likes - amount)
    update(toPost, likes: toPost.likes + amount)
  }

  true
}

/// 字符串模板 + 成员方法 / String template + member methods
api greet(name: String): String {
  val lower = name.lowercase
  val len = name.length
  "Hello ${name}, your name has ${len} characters"
}

// 写法 3: @native — 复杂逻辑交给 Go
// Style 3: @native — complex logic in Go
api oauthLogin(provider: String, code: String): AuthResult @native
api paymentCallback(payload: Json): Boolean @native

// ============================================
// stream — WebSocket 流式推送 / WebSocket stream
// ============================================

api watchComments(postId: Int): stream Comment
api watchPosts(userId: Int): stream Post

// ============================================
// fn — 函数定义 / Function definitions
// ============================================

// @native — Go 实现 / Go implementation
fn encrypt(value: String): String @native
fn verifyHash(plain: String, hashed: String): Boolean @native
fn generateToken(user: User, expires: Duration): String @native

// luxo 函数 / luxo function
fn calcDiscount(total: Float, role: Role): Float {
  when(role) {
    Role.ADMIN     -> total * 0.15
    Role.MODERATOR -> total * 0.10
    else           -> 0.0
  }
}

// 无返回值函数 / Void function
fn logAction(action: String) {
  val msg = "Action: ${action}"
  emit("log", msg)
}

// ============================================
// extend — 跨模块扩展 / Cross-module extension
// ============================================

extend User {
  posts:    [Post]
  comments: [Comment]
}

// ============================================
// error — 结构化错误 / Structured errors
// ============================================

error NotFound(resource: String) {
  code: 404
  message: error.not_found
}

error Unauthorized {
  code: 401
  message: error.unauthorized
}

error OutOfStock(productId: Int, available: Int) {
  code: 409
  message: error.out_of_stock
}

// ============================================
// middleware — 中间件 / Middleware
// ============================================

middleware customAuth @native

/*
  多行注释 / Block comment
  支持嵌套 / Supports nesting
  /* 嵌套注释 / Nested comment */
*/
