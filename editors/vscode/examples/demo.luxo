// ============================================

fn riskyOperation(id: Int): Result<User> @native

api testResult(id: Int): User {
  // ? 操作符 — Ok 取值，Err 自动 throw
  val user = riskyOperation(id)?
  user
}

// ============================================
// 无限循环 + Channel 接收 / Infinite Loop + Channel Receive
// ============================================

api testInfiniteLoop(): Int {
  var total = 0
  val ch = Channel(5)

  async {
    for i in 0..4 {
      ch <- i
    }
  }

  // 无限循环 / Infinite loop
  for {
    val value = <-ch
    total += value
    if total > 5 { break }
  }

  total
}

