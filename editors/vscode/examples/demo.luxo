/// 计算折扣 / Calculate discount
fn calcDiscount(total: Float, role: Role): Float {
  when(role) {
    Role.ADMIN     -> total * 0.15
    Role.MODERATOR -> total * 0.10
    else           -> 0.0
  }
}

// ============================================
// 运算符全覆盖 / Full Operator Coverage
// ============================================

/// 取模 + 所有复合赋值 / Modulo + all compound assignments
fn testAllOps(x: Int): Int {
  val a = x % 3
  var b = a
  b *= 2
  b /= 1
  b %= 5
  b
}

/// when 替代 if/else / when replaces if/else
api checkAge(age: Int): String {
  when {
    age >= 18 -> "adult"
    else -> "minor"
  }
}

