}

// ============================================
// my.load 懒加载 / Lazy Loading
// ============================================

api dashboard(): String @auth {
  val user = my.load(name, role) // 懒加载指定字段
  "welcome ${user.name}"
}

// ============================================
// use 展开导入 / Use with Destructuring
// ============================================

use model { Base }
// 从 common/model 展开导入
use event { PostCreated }
// 从 common/event 展开导入

/*
  多行注释 / Block comment
  支持嵌套 / Supports nesting
  /* 嵌套注释 / Nested comment */
*/

// ============================================
// ============================================
// 数据库类型注解 / Database Type Annotations
// ============================================

model AppConfig @noTime {
  key:   String @length(50)
  value: String
}

model Invoice @soft {
  seqId:     Int      @serial
  amount:    Float    @decimal(19, 4)
  traceId:   String   @uuid
  clientIp:  String   @inet
  issueDate: DateTime @date
  issueTime: DateTime @time
}

// ============================================
// 运算符覆盖 / Operator Coverage
// ============================================

/// spread 参数 / Spread params
fn sendNotification(... targets: String) @native

/// 比较运算符 / Comparison operators
api compareTest(a: Int, b: Int): String {
  when {
    a < b -> "less"
    a <= b -> "less or equal"
    else -> "greater"
  }
}

// ============================================
// 编译期安全检查（本 demo 展示正确用法）
// Compile-Time Safety Checks (demo shows correct usage)
// ============================================
// // 以下特性由编译器强制执行，不在 demo 中演示错误用法：

// The following are enforced by the compiler, not shown as errors here:
// // 1. 全局 var 禁止 — 只允许全局 val（本文件已使用 val）

// Global var forbidden — only val allowed globally (this file uses val)
// // 2. duplicate when branch 检测 — 重复分支编译报错

// Duplicate when branch detection — duplicate branches cause compile error
// // 3. unreachable code warning — return/throw/break/continue 后的代码触发警告

// Unreachable code warning — code after return/throw/break/continue triggers warning
// // 4. 嵌套 await 禁止 — await 内不能再套 await

// Nested await forbidden — cannot nest await inside await
// // 5. enum 穷举检查 — when 匹配 enum 必须覆盖所有值或有 else

// Enum exhaustive check — when on enum must cover all values or have else
// // 6. sealed 穷举检查 — when 匹配 sealed 必须覆盖所有变体

// Sealed exhaustive check — when on sealed must cover all variants
// // 7. Lambda 内禁止 CRUD — users.map { find(...) } 编译报错

// CRUD forbidden in lambda — users.map { find(...) } causes compile error
// // 8. contains 无 @search 时警告 — 全表扫描提示

// contains without @search warns — full table scan hint
// // 9. 循环事件依赖检测 — A->B->A 编译报错

// Circular event dependency detection — A->B->A causes compile error
// // ============================================

// ============================================
// 聚合查询 / Aggregate & GroupBy
// ============================================

/// 链式聚合 — 单值 / Chainable aggregate — single value
api totalRevenue(): Float {
  Order.where(status == OrderStatus.COMPLETED).sum { it.total }
}

/// 链式聚合 — 多值 / Chainable aggregate — multiple values
type OrderFullStats {
  totalRevenue: Float
  avgOrder:     Float
  orderCount:   Int
}

api orderFullStats(): OrderFullStats {
  val orders = Order.where(status == OrderStatus.COMPLETED)
  OrderFullStats {
    totalRevenue: orders.sum { it.total },
    avgOrder: orders.avg { it.total },
    orderCount: orders.count()
  }
}

/// groupBy — 链式分组 / Chainable group by
type OrderStatusStats {
  status: OrderStatus
  total:  Float
  count:  Int
}

api ordersByStatus(): [OrderStatusStats] {
  Order.groupBy { it.status }.select { group ->
    OrderStatusStats {
      status: group.key,
      total: group.sum { it.total },
      count: group.count()
    }
  }
}

/// raw — SQL 逃生舱 (⚠ compile-time warning) / SQL escape hatch
type BuyerTotal {
  userId: Int
  total:  Float
}

api topBuyers(): [BuyerTotal] {
  raw(
    "SELECT user_id, SUM(total) as total FROM orders GROUP BY user_id HAVING SUM(total) > $1",
    params: [1000]
  )
}

// ============================================
// 分页 / Pagination
// ============================================

/// offset 分页 — @paginate 零代码 / Offset pagination with @paginate
api listUsersPage(): [User] @paginate(defaultPageSize: 50) {
  User.where(role == Role.USER).orderBy(createdAt.desc)
}

/// cursor 分页 / Cursor pagination
api postFeed(cursor: String?, limit: Int = 20): Cursor < Post > {
  paginate(Post,
    where: status == PostStatus.PUBLISHED,
    cursor: cursor,
    limit: limit,
    order: createdAt.desc
  )
}

// ============================================
// @auth 多身份 + permission lambda
// Multi-identity auth + permission lambda
// ============================================

/// 允许 User 或 Admin / Allow User or Admin
api viewOrder(id: Int): Order @auth(User, Admin) {
  Order.find(id: id)
}

/// permission lambda — it 是 JWT stores 字段 / it is JWT stores fields
api deleteUser(id: Int): Boolean @auth(Admin, permission: { it.role == AdminRole.SUPER }) {
  User.find(id: id).delete()
  true
}

/// 资源所有权 / Resource ownership
api updateMyProfile(input: RegisterInput): User @auth(User, own: "id") {
  val user = User.find(id: my.id)
  user.update(name: input.name)
}

/// Admin 登录 — 用 Admin.createToken / Admin login
api adminLogin(email: String, password: String): AdminAuthResult {
  val admin = Admin.where(it.email == email).first()
    ?: throw NotFound
  admin.verify(password) ?: throw Unauthorized
  AdminAuthResult { token: admin.createToken(), admin: admin }
}

type AdminAuthResult {
  token: String
  admin: Admin
}

// ============================================
// @scope 带参数 / Parameterized scope usage
// ============================================

/// @scope 零代码 API / Zero-code API with scopes
api listPublishedPosts(): [AuditablePost] @scope(published)
api listMyPosts(): [AuditablePost] @auth(User) @scope(published, mine)
api listRecentPosts(days: Int = 7): [AuditablePost] @scope(published, recent(days))
api listHotRecentPosts(days: Int = 30): [AuditablePost] @scope(hot, recent(days))

// ============================================
// request.fields — 字段选择感知
// Field selection awareness
// ============================================

/// request.fields.has() — O(1) hash lookup
api getUserProfile(id: Int): User @auth(User) {
  val user = User.find(id: id)
  if request.fields.has("posts") {
    "client requested posts, prewarming cache".i
  }
  user
}

// ============================================
// 工具模块 / Utility Modules
// ============================================

/// math 模块 / Math module
api mathDemo(value: Float): Float {
  val abs = math.abs(value)
  val clamped = math.clamp(value, 0, 100)
  val rounded = math.round(value)
  math.max(abs, clamped)
}

/// crypto 模块 / Crypto module
api cryptoDemo(): String {
  val token = crypto.randomToken(32)
  val id = crypto.uuid()
  val digest = crypto.sha256("hello")
  token
}

/// convert 模块 / Convert module
api convertDemo(input: String): Int {
  val num = convert.toInt(input)
  val safe = convert.tryInt(input) ?: 0
  val back = convert.toString(num)
  safe
}

/// 链式调用 / Chainable methods
api chainDemo(title: String, users: [User]): String {
  val slug = title.trim.lowercase.replace(" ", "-")
  val topNames = users
    .filter { it.role == Role.ADMIN }
    .sortBy { it.name }
    .take(5)
    .map { it.name }
    .joinToString(", ")
  "${slug}: ${topNames}"
}

// ============================================
// transaction 返回值 + async 规则
// Transaction return value + async rules
// ============================================

/// transaction returns last expression / transaction 返回最后一行表达式
api placeOrder(productId: Int, qty: Int): Order @auth(User) {
  val product = Product.find(id: productId)
  product.stock >= qty ?: throw OutOfStock

  val order = transaction {
    product.stock -= qty
    product.update(stock: product.stock)
    Order.create(
      orderNo: crypto.randomToken(16),
      userId: my.id,
      productId: productId,
      quantity: qty,
      total: product.price * qty
    )
  }

  // async captures val only (not var), uses detached context
  async {
    "order placed: ${order.orderNo}".i
    emit OrderCreated(order: order, userId: my.id)
  }

  order
}

