// ============================================
// Luxo 完整业务演示 — 电商 + 社交 + 实时通信
// Complete Business Demo — E-commerce + Social + Real-time
// 覆盖所有语法特性
// ============================================

use http
use json
use time
use math
use crypto
use convert

// ============================================
// 全局常量 / Global Constants (val only — var is forbidden globally)
// ============================================

val APP_NAME = "MyShop"
val MAX_RETRIES = 3

// ============================================
// 枚举 / Enums
// ============================================

enum Role {
  USER
  ADMIN
  MODERATOR
}
enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

// ============================================
// 数据模型 / Data Models
// ============================================

/// 用户 / User — @withAuth marks as auth subject
model User @withAuth(secret: env("JWT_SECRET"), expires: 7d, stores: [id, role], default: true) @crud {
  /// 用户 ID / User ID
  id:        Int
  /// 用户名 / Username
  name:      String   @filterable
  /// 邮箱 / Email
  email:     String   @unique
  /// 密码（不返回）/ Password (hidden)
  password:  String   @hidden @hash
  /// 角色 / Role
  role:      Role     = Role.USER
  /// 头像（可空）/ Avatar (nullable)
  avatar:    String?
  /// 手机号（创建后不可改）/ Phone (immutable after create)
  phone:     String   @immutable
  /// 创建时间 / Created at
  createdAt: DateTime
}

/// 管理员 / Admin — separate auth subject
model Admin @withAuth(secret: env("ADMIN_JWT_SECRET"), expires: 1d, stores: [id, role], refresh: true) {
  id:       Int       @id @auto
  email:    String    @email @unique
  password: String    @hash @hidden
  role:     AdminRole
  name:     String
}

enum AdminRole {
  SUPER
  EDITOR
  VIEWER
}

/// 文章 / Post
model Post @crud {
  id:        Int
  /// 标题 / Title
  title:     String     @filterable
  /// 内容 / Content
  content:   String
  /// 状态 / Status
  status:    PostStatus = PostStatus.DRAFT
  /// 作者 ID / Author ID
  userId:    Int        @index
  /// 点赞数 / Like count
  likes:     Int        = 0
  createdAt: DateTime   @sortable
}

/// 评论 / Comment
model Comment {
  id:        Int
  content:   String
  postId:    Int
  userId:    Int
  createdAt: DateTime
}

/// 商品 / Product
model Product {
  id:    Int
  name:  String  @filterable
  price: Float
  stock: Int
  image: String?
}

/// 订单 / Order
model Order {
  id:        Int
  orderNo:   String      @unique
  userId:    Int
  productId: Int
  quantity:  Int
  total:     Float
  status:    OrderStatus = OrderStatus.PENDING
  createdAt: DateTime
}

/// 聊天消息 / Chat Message
model Message {
  id:        Int
  roomId:    Int
  userId:    Int
  content:   String
  createdAt: DateTime
}

/// 聊天室成员 / Room Member
model RoomMember {
  id:     Int
  roomId: Int
  userId: Int
}

// ============================================
// sealed — 支付结果 / Payment Result
// ============================================

sealed PayResult {
  Success(transactionId: String)
  Failed(reason: String, code: Int)
  Pending(retryAfter: Duration)
}

// ============================================
// 自定义类型 / Custom Types
// ============================================

type AuthResult {
  token: String
  user:  User
}

/// type supports validation annotations / type 支持验证注解
type RegisterInput {
  name:     String @notBlank @minLength(2)
  email:    String @email
  password: String @minLength(8)
  phone:    String @pattern("[0-9]{11}")
}

// Page<T> is now a built-in type — no need to define it manually

// ============================================
// interface — 审计 / Auditable
// ============================================

interface Auditable {
  createdBy: String
  updatedBy: String

  fn beforeCreate() {
    val x = 1
  }
}

// ============================================
// 错误定义 / Error Definitions
// ============================================

error NotFound(resource: String) {
  code:    404
  message: "error.not_found"
}

error Unauthorized {
  code:    401
  message: "error.unauthorized"
}

error OutOfStock(productId: Int, available: Int) {
  code:    409
  message: "error.out_of_stock"
}

error DuplicateEmail {
  code:    409
  message: "error.email_exists"
}

error PasswordTooShort {
  code:    400
  message: "error.password_too_short"
}

// ============================================
// 类型化事件 / Typed Events
// ============================================

event PostCreated(post: Post, userId: Int)
event PostPublished(post: Post)
event OrderCreated(order: Order, userId: Int)
event OrderCancelled(order: Order)
event OrderProcessed(order: Order)
event UserCreated(user: User)
event ChatMessage(message: Message, roomId: Int)

// ============================================
// 用户认证 / User Authentication
// ============================================

/// 注册 / Register — .createToken() auto-generated by @withAuth
api register(input: RegisterInput): AuthResult {
  // 密码校验 / Password validation
  input.password.length >= 8 ?: throw PasswordTooShort

  // 邮箱唯一检查 / Email uniqueness check
  val exists = User.where(email == input.email).first()
  exists == null ?: throw DuplicateEmail

  // 创建用户 / Create user — @hash auto bcrypt
  val user = User.create(
    name: input.name,
    email: input.email,
    password: input.password,
    phone: input.phone
  )

  AuthResult { token: user.createToken(), user: user }
}

/// 登录 / Login — .verify() auto-generated by @withAuth
api login(email: String, password: String): AuthResult {
  val user = User.where(it.email == email).first()
    ?: throw NotFound

  user.verify(password) ?: throw Unauthorized

  AuthResult { token: user.createToken(), user: user }
}

/// OAuth 第三方登录 / OAuth Login
api oauthLogin(provider: String, code: String): AuthResult @native

// ============================================
// 文章 CRUD / Post CRUD
// ============================================

/// 创建文章 / Create Post — @auth(User) restricts to User identity
api createPost(title: String, content: String): Post @auth(User) {
  val post = Post.create(
    title: title,
    content: content,
    userId: my.id,
    status: PostStatus.DRAFT
  )
  emit PostCreated(post: post, userId: my.id)
  post
}

/// 发布文章 / Publish Post
api publishPost(id: Int): Post @auth {
  val post = Post.find(id: id)
    ?: throw NotFound

  // dirty tracking + save / 脏字段追踪 + 保存
  post.status = PostStatus.PUBLISHED
  post.save()
  emit PostPublished(post: post)
  post
}

/// 文章列表 — @paginate 零代码分页 / Post list with @paginate
api listPosts(status: String?): [Post] @paginate {
  Post.where(status == PostStatus.PUBLISHED)
}

/// 点赞 — 原子操作 / Like — atomic operation
api likePost(id: Int): Post @auth {
  val post = Post.find(id: id)
    ?: throw NotFound
  post.likes += 1
  post.update(likes: post.likes)
  post
}

/// 搜索 — 集合操作 / Search — collection operations
api searchPosts(keyword: String): [Post] {
  val posts = Post.where(status == PostStatus.PUBLISHED).all()
  val matched = posts.filter { it.title.contains(keyword) }
  val sorted = matched.sortBy { it.createdAt }
  sorted
}

// ============================================
// 电商 — 下单流程 / E-commerce — Order Flow
// ============================================

/// 下单 / Create Order
api createOrder(productId: Int, quantity: Int): Order @auth {
  val product = Product.find(id: productId)  // auto-throws NotFound / 找不到自动抛出 NotFound

  // 库存检查 / Stock check
  product.stock >= quantity ?: throw OutOfStock

  val total = product.price * quantity

  // when 表达式 — VIP 折扣 / when expression — VIP discount
  val finalPrice = when {
    my.role == Role.ADMIN -> total * 0.5
    my.role == Role.MODERATOR -> total * 0.8
    total > 1000 -> total * 0.95
    else -> total
  }

  // 事务 — 扣库存 + 创建订单 / Transaction
  val order = transaction {
    product.stock -= quantity
    product.update(stock: product.stock)
    Order.create(
      orderNo: crypto.randomToken(16),
      userId: my.id,
      productId: productId,
      quantity: quantity,
      total: finalPrice,
      status: OrderStatus.PENDING
    )
  }

  // 异步通知 / Async notification
  async {
    "订单创建: ${order.orderNo}".i
  }

  emit OrderCreated(order: order, userId: my.id)
  order
}

/// 取消订单 / Cancel Order
api cancelOrder(id: Int): Order @auth {
  val order = Order.find(id: id)
    ?: throw NotFound

  val product = Product.find(id: order.productId)
    ?: throw NotFound

  transaction {
    product.stock += order.quantity
    product.update(stock: product.stock)
    order.status = OrderStatus.CANCELLED
    order.update(status: OrderStatus.CANCELLED)
  }

  emit OrderCancelled(order: order)
  order
}

// ============================================
// 实时聊天 / Real-time Chat
// ============================================

/// 聊天订阅 / Chat subscription (WebSocket)
api watchChat(roomId: Int): Message @stream

/// 发消息 — emit 推送 / Send message — emit push
api sendMessage(roomId: Int, content: String): Message @auth {
  // 检查是否是房间成员 / Check room membership
  val member = RoomMember.where(it.roomId == roomId && userId == my.id).first()
  member != null ?: throw Unauthorized

  val msg = Message.create(
    roomId: roomId,
    userId: my.id,
    content: content
  )

  // 查出房间所有成员 / Get all room members
  val members = RoomMember.where(it.roomId == roomId).all()
  val targetIds = members.map { it.userId }
    .filter { it != my.id }

  // emit 推送给指定用户 / Push to specific users
  emit ChatMessage(message: msg, roomId: roomId)

  msg
}

// ============================================
// 批量操作 / Batch Operations
// ============================================

/// 批量创建商品 / Create multiple products
api createProducts(names: [String], price: Float): Int @auth {
  var count = 0
  for name in names {
    Product.create(name: name, price: price, stock: 100)
    count += 1
  }
  count
}

/// 批量删除订单 / Delete multiple orders (batch)
api removeOldOrders(status: String): Int @auth {
  Order.where(it.status == status).deleteMany()
}

/// 批量更新库存 / Update stock for many products (batch)
api restockAll(amount: Int): Int @auth {
  Product.where(stock == 0).update(stock: amount)
}

/// 批量创建标签 / Batch create tags
api batchCreateProducts(names: [String], price: Float): [Product] @auth {
  Product.createMany(names)
}

/// 统计 / Count
api countActiveUsers(): Int {
  User.where(role == Role.USER).count()
}

/// 存在检查 / Exists check
api isEmailTaken(email: String): Boolean {
  User.where(it.email == email).exists()
}

/// 有则更新无则创建 / Upsert
api ensureProduct(name: String, price: Float): Product @auth {
  Product.upsert(where: it.name == name, name: name, price: price, stock: 0)
}

/// 查找第一个 / Find first
api getFirstPost(): String {
  val post = Post.where(status == PostStatus.PUBLISHED).first()
  post?.title ?: "none"
}

/// 查找多个 + 排序 + 分页 / Find many with order & pagination
api listLatestPosts(page: Int, limit: Int): [Post] {
  Post.where(status == PostStatus.PUBLISHED).orderBy(createdAt.desc).limit(limit).offset(page * limit).all()
}

// ============================================
// when 模式匹配 / Pattern Matching
// ============================================

/// 评分等级 — 范围匹配 / Score level — range matching
api getLevel(score: Int): String {
  when(score) {
    in 90..100 -> "A"
    in 80..89 -> "B"
    in 60..79 -> "C"
    else -> "D"
  }
}

/// 支付结果处理 — sealed 穷举 / Payment result — sealed exhaustive
api handlePayResult(result: PayResult): String {
  when(result) {
    is Success -> "txn: ${result.transactionId}"
    is Failed -> "error: ${result.reason}"
    is Pending -> "retry after ${result.retryAfter}"
  }
}

// ============================================
// 循环 + yield + break + continue / Loops
// ============================================

/// yield — for 作为表达式 / for as expression
api findFirstExpensive(products: [Product]): Product {
  val found = for product in products {
    if product.price > 1000 { yield product }
  }
  found ?: throw NotFound
}

/// 条件循环 + 赋值 / Conditional loop + assignment
api sumUntil(items: [Int], limit: Int): Int {
  var total = 0
  var i = 0
  for i < items.size {
    total += 1
    if total >= limit { break }
    i += 1
  }
  total
}

/// continue — 跳过偶数 / Skip even numbers
api sumOdds(items: [Int]): Int {
  var total = 0
  for item in items {
    if item % 2 == 0 { continue }
    total += item
  }
  total
}

/// 集合操作综合 / Collection operations
api analyzeOrders(orders: [Order]): String {
  val total = orders.sumOf { it.total }
  val avg = total / orders.size
  val expensive = orders.filter { it.total > 500 }
  val hasVip = orders.any { it.total > 10000 }
  val grouped = orders.groupBy { it.status }
  val ids = orders.map { it.id }.joinToString(", ")
  "total: ${total}, avg: ${avg}, expensive: ${expensive.size}"
}

// ============================================
// 并发 / Concurrency
// ============================================

/// await — 并发加载 / Concurrent loading
api getUserProfile(id: Int): User @auth {
  val(user, posts, orders) = await {
    User.find(id: id)
    Post.where(userId == id).all()
    Order.where(userId == id).all()
  }
  user
}

/// async — 后台任务 / Background task
api processAndNotify(orderId: Int): Boolean @auth {
  val order = Order.find(id: orderId)
    ?: throw NotFound

  async {
    "processing order ${order.orderNo}".i
    emit OrderProcessed(order: order)
  }

  true
}

/// Channel — 协程通信 / Coroutine communication
api testChannel(): Int {
  val ch = Channel(10)

  async {
    for i in 0..9 {
      ch <- i
    }
  }

  var sum = 0
  for value in ch {
    sum += value
    if sum > 20 { break }
  }
  sum
}

// ============================================
// 标准库使用 / Standard Library
// ============================================

/// String 操作 / String operations
api formatUserInfo(user: User): String {
  val name = user.name.trim.lowercase
  val emailDomain = user.email.split("@").last
  val masked = user.phone.substring(0, 3) + "****" + user.phone.substring(7, 11)
  "name: ${name}, domain: ${emailDomain}, phone: ${masked}"
}

/// HTTP 调用 / HTTP request
api fetchExternalData(url: String): String {
  val response = http.get(url)
  val data = json.parse(response.body)
  json.stringify(data)
}

/// 时间操作 / Time operations
api getTimeInfo(): String {
  val now = time.now()
  val formatted = now.format("2006-01-02 15:04:05")
  val tomorrow = now.add(1d)
  "now: ${formatted}, tomorrow: ${tomorrow.format("2006-01-02")}"
}

/// request 上下文 / Request context
api getRequestInfo(): String @auth {
  val ip = request.ip
  val ua = request.header("User-Agent")
  val method = request.method
  "ip: ${ip}, ua: ${ua}, method: ${method}"
}

// ============================================
// 继承 + 计算字段 + 注解全覆盖
// Inheritance + Computed Fields + All Directives
// ============================================

/// 基础模型 / Base model
model Base {
  id:        Int
  createdAt: DateTime
  updatedAt: DateTime
}

/// 带审计的文章（继承 Base）/ Auditable post (inherits Base)
model AuditablePost: Base {
  title:      String
  /// 内部状态（用户不可设）/ Internal status
  internal:   String  @internal
  /// 可见性条件 / Visibility condition
  secret:     String  @visible(my.role == Role.ADMIN)
  /// CDN 变换 / CDN transform
  cover:      String  @transform { "https://cdn.example.com/${cover}" }
  /// 存前小写 / Lowercase before save
  slug:       String  @beforeSave { slug.lowercase }
  /// 手机脱敏 / Phone masking
  phone:      String  @mask("***####****")
  /// 已弃用 / Deprecated
  oldField:   String? @deprecated("use newField")
  /// 缓存接口 / Cached API
  cachedData: String?

  // 计算字段 / Computed fields
  val commentCount: Int get @count
  val avgRating: Float get @avg(field: likes)
  val totalLikes: Int get @sum(field: likes)
  val bestLike: Int get @max(field: likes)
  val worstLike: Int get @min(field: likes)

  // 查询预设 / Query scopes
  scope published = where(status == PostStatus.PUBLISHED)

  scope mine = where(userId == my.id)

  // 带参数的 scope / Parameterized scope
  scope recent(days: Int) = where(createdAt > now() - days.days)

  scope hot = where(likes > 100).orderBy(likes.desc)
}

// ============================================
// 多态 + 多对多 / Polymorphic + Many-to-Many
// ============================================

model Video {
  id:    Int
  title: String
}

/// 评论目标（多态）/ Comment target (polymorphic)
model Reaction {
  id:     Int
  target: (Post, Video, Product)
  userId: Int
}

/// 用户角色（一对多中间表）/ User-Role relation
model UserRole: Base {
  userId: Int
  roleId: Int
}

// ============================================
// use — 跨模块引用 / Cross-module Import
// ============================================

use common.{ Base, Page }

// ============================================
// 跨模块扩展 / Cross-module Extension
// ============================================

extend User {
  posts:    [Post]
  orders:   [Order]
  comments: [Comment]
}

// ============================================
// override — 覆盖自动 CRUD / Override Auto CRUD
// ============================================

override api createUser(input: RegisterInput): User {

  val user = User.create(
    name: input.name,
    email: input.email,
    password: input.password,
    phone: input.phone
  )
  emit UserCreated(user: user)
  user
}

// ============================================
// @cache — 缓存 / Caching
// ============================================

api getPopularPosts(): [Post] @cache(ttl: 60) {
  val posts = Post.where(status == PostStatus.PUBLISHED).all()
  posts.sortBy { it.likes }
}

/// 限流 / Rate limiting
api publicFeed(): [Post] @rateLimit(max: 100, window: 1m) {
  Post.where(status == PostStatus.PUBLISHED).all()
}

/// 流式响应 / Streaming response
api liveUpdates(): Post @stream

// ============================================
// 空安全全路径 / Null Safety Full Path
// ============================================

api testNullSafety(userId: Int): String {
  // first() returns nullable — use for null safety demo
  val user = User.where(id == userId).first()

  // ?. 安全调用 / Safe call
  val name = user?.name
  val upper = user?.name?.uppercase
  // ?: Elvis
  val displayName = user?.name ?: "Anonymous"

  // .let 作用域函数 / Scope function
  val result = user?.let { "found: ${it.name}" }
  // 显式 return / Explicit return
  if user == null {
    return "not found"
  }

  displayName
}

// ============================================
// 逻辑运算 + 字面量 / Logic Ops + Literals
// ============================================

api testLogic(a: Boolean, b: Boolean): Boolean {
  val x = a && b
  val y = a || b
  val z = !a
  val isTrue = true
  val isFalse = false
  val nothing = null

  if x && !y {
    return isTrue
  }

  isFalse
}

// ============================================
// Result<T> + ? 操作符 / Result + ? Operator
// ============================================

fn riskyOperation(id: Int): Result < User > @native
api testResult(id: Int): User {

  // ? 操作符 — Ok 取值，Err 自动 throw
  val user = riskyOperation(id)?
  user
}

// ============================================
// 无限循环 + Channel 接收 / Infinite Loop + Channel Receive
// ============================================

api testInfiniteLoop(): Int {
  var total = 0
  val ch = Channel(5)

  async {
    for i in 0..4 {
      ch <- i
    }
  }

  // 无限循环 / Infinite loop
  for {
    val value = <- ch
    total += value
    if total > 5 { break }
  }

  total
}

// ============================================
// 中间件 / Middleware
// ============================================

middleware adminOnly @native

// ============================================
// @native 函数 / Native Functions
// ============================================

fn sendEmail(to: String, subject: String, body: String) @native
fn sendSms(phone: String, content: String) @native

/// 计算折扣 / Calculate discount
fn calcDiscount(total: Float, role: Role): Float {
  when(role) {
    Role.ADMIN -> total * 0.15
    Role.MODERATOR -> total * 0.10
    else -> 0.0
  }
}

// ============================================
// 运算符全覆盖 / Full Operator Coverage
// ============================================

/// 取模 + 所有复合赋值 / Modulo + all compound assignments
fn testAllOps(x: Int): Int {
  val a = x % 3
  var b = a
  b *= 2
  b /= 1
  b %= 5
  b
}

/// when 替代 if/else / when replaces if/else
api checkAge(age: Int): String {
  when {
    age >= 18 -> "adult"
    else -> "minor"
  }
}

// ============================================
// 数据库类型注解 / Database Type Annotations
// ============================================

model Config @noTime {
  key:   String @length(50)
  value: String
}

model Payment @soft {
  orderId:  Int      @bigint
  amount:   Float    @decimal(19, 4)
  traceId:  String   @uuid
  clientIp: String   @inet
  paidDate: DateTime @date
  paidTime: DateTime @time
}

// ============================================
// 注解全覆盖 / Full Directive Coverage
// ============================================

/// 验证注解 (String) / String Validation Directives
model UserProfile {
  /// 主键 / Primary key
  id:       Int     @id @auto
  /// 邮箱格式 / Email format
  email:    String  @email @unique
  /// 正则校验 / Regex pattern
  phone:    String  @pattern("[0-9]{11}")
  /// 最短长度 / Min length
  username: String  @minLength(3)
  /// 最长长度 / Max length
  bio:      String  @maxLength(500)
  /// 不能为空 / Not blank
  nickname: String  @notBlank
  /// 加密存储 / Encrypted storage
  ssn:      String  @encrypt
  /// 全文搜索 / Full-text search
  intro:    String  @search
  /// 保留字段 / Reserved field
  _future:  String? @reserved
}

/// 验证注解 (Numeric) / Numeric Validation Directives
model GameScore {
  id:    Int
  /// 数值范围校验 / Range check
  score: Int   @range(0, 100)
  /// 范围约束 / Range constraint
  level: Float @range(1, 99)
}

/// 数据库类型全覆盖 / Full Database Type Coverage
model GeoData {
  id:        Int
  /// 小整数 / Small integer
  category:  Int      @smallint
  /// 地理坐标 / Geographic point
  location:  String   @point
  /// BRIN 索引（时序）/ BRIN index (time-series)
  createdAt: DateTime @brin
  /// 向量嵌入 / Vector embedding (pgvector)
  embedding: String   @vector(dim: 1536)
}

// ============================================
// 事件订阅 / Event Listeners
// ============================================

on UserCreated {
  "user created".i
}

on OrderCreated @native

on PostPublished { post -> "published".i
}

